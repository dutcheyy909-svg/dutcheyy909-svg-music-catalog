          },
          "plugin": {
            "type": [
              "string",
              "null"
            ]
          },
          "preset": {
            "type": [
              "string",
              "null"
            ]
          },
          "settings": {
            "type": "object",
            "additionalProperties": true
          },
          "bypassed": {
            "type": "boolean",
            "default": false
          },
          "notes": {
            "type": "string"
          }
        }
      }

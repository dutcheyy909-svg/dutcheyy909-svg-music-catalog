{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dutcheyy.studio/schemas/release.schema.json",
  "title": "Dutcheyy Studio Release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_id",
    "title",
    "release_type",
    "status",
    "project_ids"
  ],
  "properties": {
    "release_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "release_type": {
      "type": "string",
      "enum": [
        "single",
        "ep",
        "album",
        "compilation",
        "other"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "planning",
        "scheduled",
        "delivered",
        "released",
        "cancelled"
      ]
    },
    "primary_artist": {
      "type": "string"
    },
    "project_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "release_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "upc": {
      "type": [
        "string",
        "null"
      ]
    },
    "label": {
      "type": [
        "string",
        "null"
      ]
    },
    "distributor": {
      "type": [
        "string",
        "null"
      ]
    },
    "catalog_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "copyright_year": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1900
    },
    "copyright_holder": {
      "type": [
        "string",
        "null"
      ]
    },
    "phonographic_year": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1900
    },
    "phonographic_holder": {
      "type": [
        "string",
        "null"
      ]
    },
    "rights_status": {
      "type": "string",
      "enum": [
        "unverified",
        "partially_verified",
        "verified"
      ]
    },
    "artwork": {
      "type": [
        "string",
        "null"
      ]
    },
    "platform_links": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "format": "uri"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}

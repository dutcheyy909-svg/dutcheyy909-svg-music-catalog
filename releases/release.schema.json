{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Release Schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "copyright_holder": {
      "type": ["string", "null"]
    },
    "phonographic_holder": {
      "type": ["string", "null"]
    },
    "rights_status": {
      "type": "string",
      "enum": [
        "unverified",
        "partially_verified",
        "verified"
      ]
    }
  },
  "required": ["id", "title", "rights_status"]
}
